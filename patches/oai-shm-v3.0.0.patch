diff --git a/openair2/LAYER2/nr_pdcp/nr_pdcp_entity.c b/openair2/LAYER2/nr_pdcp/nr_pdcp_entity.c
index bd7c717..016a765 100644
--- a/openair2/LAYER2/nr_pdcp/nr_pdcp_entity.c
+++ b/openair2/LAYER2/nr_pdcp/nr_pdcp_entity.c
@@ -16,6 +16,10 @@
 
 #include "LOG/log.h"
 
+/* WD 5Ghoul: SHM interface */
+#include "shm_interface/wd_shm_nr_utils.h"
+/* ------------------------ */
+
 /**
  * @brief returns the maximum PDCP PDU size
  *        which corresponds to data PDU for DRBs with 18 bits PDCP SN
@@ -138,6 +142,19 @@ static void nr_pdcp_entity_recv_pdu(nr_pdcp_entity_t *entity,
     }
   }
 
+  /* WD 5Ghoul: RX NR gNB interception */
+  if (entity->is_gnb) {
+    send_pdu_data_pdcp_nr(
+        NR_DIRECTION_UPLINK,
+        (entity->type == NR_PDCP_SRB ? SIGNALING_PLANE_NR : USER_PLANE_NR),
+        entity->rb_id == 0 ? BEARER_CCCH : BEARER_DCCH,
+        entity->pdusession_id,
+        entity->sn_size,
+        false, 0,
+        buffer, header_size + size + integrity_size);
+  }
+  /* ------------------------ */
+
   if (rcvd_count < entity->rx_deliv
       || nr_pdcp_sdu_in_list(entity->rx_list, rcvd_count)) {
     /* 1280 ms = 128 frames @ 10 ms, to match MAC cadence */
@@ -263,6 +280,20 @@ static int nr_pdcp_entity_process_sdu(nr_pdcp_entity_t *entity,
 
   memcpy(buf + header_size, buffer, size);
 
+  /* WD 5Ghoul: TX NR gNB interception (plaintext, MAC-I cleared) */
+  if (entity->is_gnb) {
+    memset(buf + header_size + size, 0, integrity_size);
+    send_pdu_data_pdcp_nr(
+        NR_DIRECTION_DOWNLINK,
+        (entity->type == NR_PDCP_SRB ? SIGNALING_PLANE_NR : USER_PLANE_NR),
+        entity->rb_id == 0 ? BEARER_CCCH : BEARER_DCCH,
+        entity->pdusession_id,
+        entity->sn_size,
+        false, 0,
+        (uint8_t *)buf, header_size + size + integrity_size);
+  }
+  /* ------------------------ */
+
   if (entity->has_integrity) {
     uint8_t integrity[PDCP_INTEGRITY_SIZE] = {0};
     entity->integrity(entity->integrity_context,
@@ -283,6 +314,19 @@ static int nr_pdcp_entity_process_sdu(nr_pdcp_entity_t *entity,
                    entity->rb_id, count, entity->is_gnb ? 1 : 0);
   }
 
+  /* WD 5Ghoul: TX NR gNB interception (ciphered PDU) */
+  if ((entity->has_integrity || entity->has_ciphering) && entity->is_gnb) {
+    send_pdu_data_pdcp_nr(
+        NR_DIRECTION_UPLINK,
+        (entity->type == NR_PDCP_SRB ? SIGNALING_PLANE_NR : USER_PLANE_NR),
+        entity->rb_id == 0 ? BEARER_CCCH : BEARER_DCCH,
+        entity->pdusession_id,
+        entity->sn_size,
+        true, 0,
+        (uint8_t *)buf, header_size + size + integrity_size);
+  }
+  /* ------------------------ */
+
   entity->tx_next++;
 
   entity->stats.txpdu_pkts++;
