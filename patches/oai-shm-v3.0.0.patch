@@ -1173,6 +1191,29 @@ static void generate_dl_mac_pdu(gNB_MAC_INST *mac,
       LOG_D(NR_MAC, "%d.%2d UE %04x TA scheduled, setting next TA frame to %d\n", frame, slot, UE->rnti, sched_ctrl->ta_frame);
     }
 
+    /* WD 5Ghoul: SHM interface - mutation (inject the queued PDU into the TB).
+     * Same framing as 2023.w03: payload followed by an 8-byte packet id, the TB
+     * is filled first and the PDU is then reported to the fuzzer with the
+     * W_INJECTED flag. */
+    mq_msg_t *inj_pkt = shm_mq_recv(W_MQ_MAC_DL);
+    uint64_t pkt_id = 0;
+    if (inj_pkt) {
+      int inj_len = inj_pkt->msg_size - 8;
+      memcpy(harq->transportBlock.buf, inj_pkt->msg_buf, (inj_len > TBS ? TBS : inj_len));
+      pkt_id = *((uint64_t *)(inj_pkt->msg_buf + inj_len));
+      LOG_E(MAC, "[DUP] TBS = %d, len=%d, buf: %02x %02x %02x %02x %02x %02x ...\n",
+            TBS, inj_pkt->msg_size,
+            inj_pkt->msg_buf[0], inj_pkt->msg_buf[1], inj_pkt->msg_buf[2],
+            inj_pkt->msg_buf[3], inj_pkt->msg_buf[4], inj_pkt->msg_buf[5]);
+    }
+    /* Send data to fuzzer (DLSCH), flagged when the TB carries an injection */
+    send_pdu_data_nr(W_GNB_MAC_UE_DL_PDU_WITH_DATA | (inj_pkt ? W_INJECTED : 0),
+                     NR_DIRECTION_DOWNLINK,
+                     NR_C_RNTI, rnti,
+                     frame, slot, pkt_id,
+                     (uint8_t *)harq->transportBlock.buf, TBS);
+    /* -------------------- */
+
     T(T_GNB_MAC_DL_PDU_WITH_DATA,
       T_INT(module_id),
       T_INT(0),
