@@ -0,0 +1,14 @@
+#!/bin/bash
+
+cd webui
+
+package='missing:'
+if [ $(npm list | grep -c $package) -ne 0 ]; then
+    npm install
+fi
+
+npm run dev
+
+cd ..
+
+
