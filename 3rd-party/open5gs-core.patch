diff --git a/tests/core/pkbuf-test.c b/tests/core/pkbuf-test.c
index 797a71faa84e34444df57bc94a12c18352c11792..7c7e4a410109fc6be331ed2f918ca2171eb1f07d 100644
--- a/tests/core/pkbuf-test.c
+++ b/tests/core/pkbuf-test.c
@@ -70,12 +70,31 @@ static void test2_func(abts_case *tc, void *data)
     ogs_pkbuf_free(p3);
 }
 
+static void test_zero_capacity_copy(abts_case *tc, void *data)
+{
+    ogs_pkbuf_t *pkbuf = ogs_pkbuf_alloc(NULL, 0);
+    ogs_pkbuf_t *copy;
+
+    ABTS_PTR_NOTNULL(tc, pkbuf);
+    if (!pkbuf) return;
+    copy = ogs_pkbuf_copy(pkbuf);
+    ogs_pkbuf_free(pkbuf);
+    ABTS_PTR_NOTNULL(tc, copy);
+    if (!copy) return;
+
+    ABTS_INT_EQUAL(tc, 0, copy->len);
+    ABTS_TRUE(tc, copy->head == copy->end);
+    ABTS_TRUE(tc, copy->data == copy->tail);
+    ogs_pkbuf_free(copy);
+}
+
 abts_suite *test_pkbuf(abts_suite *suite)
 {
     suite = ADD_SUITE(suite)
 
     abts_run_test(suite, test1_func, NULL);
     abts_run_test(suite, test2_func, NULL);
+    abts_run_test(suite, test_zero_capacity_copy, NULL);
 
     return suite;
 }
