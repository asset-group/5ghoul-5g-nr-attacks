+    /* WD 5Ghoul: SHM interface (was the dl_lc_ids loop in nr_schedule_ue_spec).
+     * While an injected PDU is queued no RLC data is placed into the TB, so the
+     * injected payload is the only content. */
+    if (sched_ctrl->num_total_bytes > 0 && shm_mq_available(W_MQ_MAC_DL) < 8) {
       /* ask the LCID allocation policy how many bytes each LC gets */
