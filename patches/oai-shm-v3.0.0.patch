@@ -301,6 +304,18 @@ static uint32_t update_dlsch_buffer(frame_t frame, slot_t slot, NR_UE_info_t *UE
   sched_ctrl->num_total_bytes = 0;
   int dl_pdus_total = 0;
 
+  /* WD 5Ghoul: SHM interface (was nr_store_dlsch_buffer in 2023.w03).
+   * A queued injection carries its own 8-byte packet id trailer: expose its
+   * payload length as the pending byte count and skip the RLC status query so
+   * the scheduler builds a TB of exactly that size. */
+  const int shm_len = shm_mq_available(W_MQ_MAC_DL);
+  if (shm_len >= 8) {
+    sched_ctrl->num_total_bytes = shm_len - 8;
+    LOG_E(MAC, "[DUP] sched_ctrl->num_total_bytes = %d \n", sched_ctrl->num_total_bytes);
+    return sched_ctrl->num_total_bytes;
+  }
